# Copie para .env.local para rodar com assinatura em um build de desenvolvimento.
# Liga o plano grátis/Premium (os perfis do eas.json já definem "on").
EXPO_PUBLIC_MONETIZATION=on

# Chaves públicas do SDK do RevenueCat: Project settings > API keys.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
