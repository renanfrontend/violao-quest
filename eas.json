{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_MONETIZATION": "on" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_MONETIZATION": "on" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_MONETIZATION": "on" }
    }
  },
  "submit": {
    "production": {}
  }
}
